{
  "$schema": "https://opencode.ai/config.json",
  // T2N MCP suite (T-hat-N): consolidated to two servers sharing mcp/t2n/core.
  //   t2n_core = repokeeper + archivist + science + scribe + watchtower (30 tools)
  //   t2n_viz  = illumina renderers + materials client (7 tools)
  // Writes are allowlisted to mcp/out ONLY (reports/ is sealed).
  // shp_bridge / shp_asymmetric_wager live in the global config and are not touched.
  // Paths absolute -> cwd-independent; no secrets needed here.
  "mcp": {
    "servers": {
      "t2n_core": {
        "type": "local",
        "command": ["C:\\Python314\\python.exe", "-u", "D:\\Opencode AI Agent\\mcp\\t2n_core.py"],
        "environment": {
          "T2N_REPO_ROOT": "D:\\Opencode AI Agent",
          "T2N_WRITE_ROOTS": "D:\\Opencode AI Agent\\mcp\\out",
          "PYTHONIOENCODING": "utf-8"
        },
        "timeout": { "startup": 30000, "catalog": 30000, "execution": 7200000 }
      },
      "t2n_viz": {
        "type": "local",
        "command": ["C:\\Python314\\python.exe", "-u", "D:\\Opencode AI Agent\\mcp\\t2n_viz.py"],
        "environment": {
          "T2N_REPO_ROOT": "D:\\Opencode AI Agent",
          "T2N_WRITE_ROOTS": "D:\\Opencode AI Agent\\mcp\\out",
          "PYTHONIOENCODING": "utf-8"
        },
        "timeout": { "startup": 30000, "catalog": 30000, "execution": 600000 }
      }
    }
  }
}

#!/usr/bin/env bash
# BB(5) audit Phase A runner (transient tool; NOT committed).
# Pre-registered in reports/AUDIT_BB5_PREREG_2026-10-18.md (commit fe90659).
set -u
REPO="/mnt/d/Opencode AI Agent"
WORK="/tmp/bb5"
LOG="$REPO/reports/audit_bb5_phaseA_2026-10-18.log"
mkdir -p "$WORK"
cd "$REPO" || exit 1

exec > >(tee -a "$LOG") 2>&1

echo "=== bb5 phaseA start $(date -u +%Y-%m-%dT%H:%M:%SZ) ==="
echo "HEAD: $(git rev-parse HEAD)"
echo "--- runner script (verbatim):"
cat "$0"
echo "--- tool hashes:"
sha256sum audit_bb5/bb5_engine_p.py audit_bb5/bb5_engine_q.py audit_bb5/artifact_checks.py

echo "--- W: engine P run1 (canonical)"
nice -n 10 python3 audit_bb5/bb5_engine_p.py --out reports/audit_bb5_witnesses_p_2026-10-18.json
echo "W-P-run1-exit:$?"
echo "--- W: engine P run2 (determinism)"
nice -n 10 python3 audit_bb5/bb5_engine_p.py --out "$WORK/w_p2.json"
echo "W-P-run2-exit:$?"
cmp -s reports/audit_bb5_witnesses_p_2026-10-18.json "$WORK/w_p2.json" && echo "DETERMINISM_P_OK" || echo "DETERMINISM_P_FAIL"
echo "--- W: engine Q run1 (canonical)"
nice -n 10 python3 audit_bb5/bb5_engine_q.py --out reports/audit_bb5_witnesses_q_2026-10-18.json
echo "W-Q-run1-exit:$?"
echo "--- W: engine Q run2 (determinism)"
nice -n 10 python3 audit_bb5/bb5_engine_q.py --out "$WORK/w_q2.json"
echo "W-Q-run2-exit:$?"
cmp -s reports/audit_bb5_witnesses_q_2026-10-18.json "$WORK/w_q2.json" && echo "DETERMINISM_Q_OK" || echo "DETERMINISM_Q_FAIL"

python3 - <<'PYEOF'
import json
p = json.load(open('reports/audit_bb5_witnesses_p_2026-10-18.json'))
q = json.load(open('reports/audit_bb5_witnesses_q_2026-10-18.json'))
pm = {r['label']: (r['steps'], r['ones']) for r in p['results']}
qm = {r['label']: (r['steps'], r['ones']) for r in q['results']}
ok = (pm == qm) and p['all_match'] and q['all_match']
print('CROSS_ENGINE_AGREE=%s' % ok)
if not ok:
    for k in sorted(set(pm) | set(qm)):
        if pm.get(k) != qm.get(k):
            print('DISAGREE', k, pm.get(k), qm.get(k))
PYEOF

echo "--- S: statement file"
curl -sSfL "https://raw.githubusercontent.com/ccz181078/Coq-BB5/9142e219229baf2245d3f70851947230ea28a318/CoqBB5/BB5/BB5_Statement.v" -o "$WORK/BB5_Statement.v"
echo "S-curl-exit:$?"
wc -l -c "$WORK/BB5_Statement.v"
python3 audit_bb5/artifact_checks.py sha256lf "$WORK/BB5_Statement.v"
grep -n "Definition BB5 := 47176870%N." "$WORK/BB5_Statement.v"
grep -n "BB5_value_statement" "$WORK/BB5_Statement.v"
grep -n "HaltsAtPlusOne" "$WORK/BB5_Statement.v" | head -20

echo "--- H: clone + hygiene scan"
if [ ! -d "$WORK/Coq-BB5-git/.git" ]; then
  git clone -q https://github.com/ccz181078/Coq-BB5.git "$WORK/Coq-BB5-git"
  echo "clone-exit:$?"
fi
git -C "$WORK/Coq-BB5-git" checkout -q 9142e219229baf2245d3f70851947230ea28a318
echo "H-checkout-exit:$?"
git -C "$WORK/Coq-BB5-git" rev-parse HEAD
git -C "$WORK/Coq-BB5-git" status --porcelain
cd "$WORK/Coq-BB5-git"
for pat in Admitted admit Axiom Axioms Parameter Parameters Conjecture Hypothesis Abort; do
  n=$(grep -rE "\b${pat}\b" --include='*.v' . | wc -l)
  echo "H-COUNT ${pat}: ${n}"
done
echo "H-HITS (head -400):"
grep -rnE '\b(Admitted|admit|Axiom|Axioms|Parameter|Parameters|Conjecture|Hypothesis|Abort)\b' --include='*.v' . | head -400
cd "$REPO"

echo "--- P: zenodo tarball + weld"
curl -sSfL "https://zenodo.org/api/records/17061968/files/Coq-BB5-1.0.0.tar.gz/content" -o "$WORK/Coq-BB5-1.0.0.tar.gz"
echo "P-curl-exit:$?"
md5sum "$WORK/Coq-BB5-1.0.0.tar.gz"
sha256sum "$WORK/Coq-BB5-1.0.0.tar.gz"
python3 audit_bb5/artifact_checks.py weld-tar "$WORK/Coq-BB5-1.0.0.tar.gz" "$WORK/Coq-BB5-git" --out reports/audit_bb5_weld_2026-10-18.json

echo "--- E: bb3 enumeration"
curl -sSfL "https://zenodo.org/api/records/17061968/files/BB3_verified_enumeration.csv/content" -o "$WORK/BB3_verified_enumeration.csv"
echo "E-curl-exit:$?"
md5sum "$WORK/BB3_verified_enumeration.csv"
sha256sum "$WORK/BB3_verified_enumeration.csv"
python3 audit_bb5/artifact_checks.py bb3-max "$WORK/BB3_verified_enumeration.csv" --engine p --out reports/audit_bb5_bb3_p_2026-10-18.json
echo "E-P-exit:$?"
python3 audit_bb5/artifact_checks.py bb3-max "$WORK/BB3_verified_enumeration.csv" --engine q --out reports/audit_bb5_bb3_q_2026-10-18.json
echo "E-Q-exit:$?"

python3 - <<'PYEOF'
import json
p = json.load(open('reports/audit_bb5_bb3_p_2026-10-18.json'))
q = json.load(open('reports/audit_bb5_bb3_q_2026-10-18.json'))
keys = ['max_steps', 'max_ones', 'max_steps_machines', 'max_ones_machines', 'anomalies']
ok = all(p[k] == q[k] for k in keys)
print('E-PQ-AGREE=%s' % ok)
for k in keys:
    v = p[k]
    print(k, '=', ('%d entries' % len(v)) if isinstance(v, list) else v)
PYEOF

echo "=== bb5 phaseA end $(date -u +%Y-%m-%dT%H:%M:%SZ) ==="
